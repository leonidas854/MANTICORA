# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
#  Manticora
# ---------------------------------------------------------------------------

# 'build' es un enlace simbolico a ext4 (el proyecto vive en NTFS), no un
# directorio: la regla con barra final no lo cubre.
/build

# Registros y descargas del instalador (setup.sh)
.setup-logs/
*.setup-logs/

# APK y demas artefactos listos para distribuir: pesan decenas de MB y se
# regeneran con './setup.sh build'.
/dist/
*.apk
*.aab
*.apks
*.aar

# Claves de firma. Nunca deben acabar en el repositorio.
*.jks
*.keystore
key.properties
android/key.properties

# Configuracion local de la maquina (rutas del SDK)
android/local.properties
android/.gradle/
.gradle/

# Salidas de escritorio
/linux/flutter/ephemeral/
/windows/flutter/ephemeral/
/macos/Flutter/ephemeral/

# Base de datos y ficheros de prueba que se generan al ejecutar
*.db
*.db-shm
*.db-wal
*.db.corrupta

# Documentos reales usados por las pruebas de calidad: se descargan con
# './setup.sh corpus' y las pruebas se saltan solas si no estan.
/test/corpus/

# Cobertura de pruebas
/coverage/
lcov.info
